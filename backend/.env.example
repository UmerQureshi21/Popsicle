# Copy to .env to override defaults.
DATABASE_URL=postgresql+psycopg://localhost:5442/cold_emailer
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
# GOOGLE_CLIENT_SECRETS=credentials.json
# From https://hunter.io/api-keys, for finding people at a company.
HUNTER_API_KEY=

# Login. Locally anyone gets in; when deployed set this to true so only accounts you create
# with `python -m app.manage create-user` can use Popsicle.
AUTH_REQUIRED=false
# Deployed over https:
# COOKIE_SECURE=true
