# Copy to .env to override defaults.
DATABASE_URL=postgresql+psycopg://localhost:5442/cold_emailer
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
# GOOGLE_CLIENT_SECRETS=credentials.json
# Deployed (Railway has no secret files): the whole contents of credentials.json instead.
# GOOGLE_CLIENT_SECRETS_JSON=
# From https://hunter.io/api-keys, for finding people at a company.
HUNTER_API_KEY=

# Login is off on localhost and always on anywhere else (it can't be turned off when deployed).
# AUTH_REQUIRED=true
# Encrypts the Gmail login in the database. Required when deployed; optional locally. Make one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TOKEN_ENCRYPTION_KEY=
