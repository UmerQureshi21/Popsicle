# Settings for self-hosting with Docker (README.md → "Self-hosting with Docker").
# Copy this file to .env in the same folder and fill it in. Git ignores .env; never commit it.

# The site's public address: https, with no slash at the end (e.g. https://popsicle.example.com).
# Also add <this address>/api/gmail/callback to your Google OAuth client's redirect URIs.
POPSICLE_URL=

# The only emails that can log in, comma-separated.
ALLOWED_EMAILS=

# Random secrets: make each one with the command above it.
# python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
TOKEN_ENCRYPTION_KEY=
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PROXY_SECRET=
# python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# The whole contents of your Google OAuth client's JSON file (credentials.json), kept inside the
# single quotes. Needed to connect Gmail.
GOOGLE_CLIENT_SECRETS_JSON=''

# From https://hunter.io/api-keys, for Find people and Look up.
HUNTER_API_KEY=

# Uncomment to also run the bundled Caddy, which serves POPSICLE_URL over HTTPS on ports 80 and
# 443 and gets the certificate by itself. Leave it out behind your own reverse proxy.
# COMPOSE_PROFILES=caddy

# The port your own reverse proxy talks to (http://127.0.0.1:3000 on this machine). Not needed
# with the bundled Caddy.
# POPSICLE_PORT=3000
